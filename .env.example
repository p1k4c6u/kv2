# Database connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/kv_listings

# OpenRouter API (for LLM analysis)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Authentication
APP_PASSWORD=your-secure-password
JWT_SECRET=your-32-character-random-secret-here

# Scraping mode (set to true for headless/cloud)
HEADLESS=false

# Proxy for bypassing Cloudflare on datacenter IPs (Railway, etc.)
# Without this, CF managed challenges will block headless scraping.
# Use a residential or SOCKS5 proxy. Format: http://user:pass@host:port
# Options: Webshare (free tier), Proxy6 (~$1/mo), BrightData, Smartproxy
# PROXY_URL=http://user:pass@proxy.example.com:8080

# Frontend URL (for CORS, production only)
# FRONTEND_URL=https://your-frontend.vercel.app
