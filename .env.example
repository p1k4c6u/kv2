# Database connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/kv_listings

# OpenRouter API (for LLM analysis)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Authentication
APP_PASSWORD=your-secure-password
JWT_SECRET=your-32-character-random-secret-here

# Scraping mode (set to true for headless/cloud)
HEADLESS=false

# Frontend URL (for CORS, production only)
# FRONTEND_URL=https://your-frontend.vercel.app
