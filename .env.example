# Database connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/kv_listings

# OpenRouter API (for LLM analysis)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Authentication
APP_PASSWORD=your-secure-password
JWT_SECRET=your-32-character-random-secret-here

# Scraping mode (set to true for headless/cloud)
HEADLESS=false

# Proxy for routing browser traffic (helps with CF but not sufficient alone)
# Format: http://user:pass@host:port
# PROXY_URL=http://user:pass@proxy.example.com:8080

# 2captcha API key — required for solving Cloudflare challenges in headless mode.
# Sign up at https://2captcha.com, get API key from dashboard.
# Cost: ~$0.001 per CF solve. First solve per scrape session, then cookie persists.
# TWOCAPTCHA_API_KEY=your_api_key_here

# Frontend URL (for CORS, production only)
# FRONTEND_URL=https://your-frontend.vercel.app
